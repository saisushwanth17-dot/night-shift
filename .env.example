# GitHub API Configuration
GITHUB_TOKEN=ghp_your_personal_access_token_here
NIGHTSHIFT_DEFAULT_REPO=owner/repo-name

# AWS Bedrock / LLM Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Execution Sandbox Configuration
SANDBOX_MODE=local  # Options: 'docker' or 'local' (isolated temp directory fallback)
SANDBOX_DOCKER_IMAGE=python:3.11-slim
SANDBOX_TIMEOUT_SECONDS=60

# Database
NIGHTSHIFT_DB_PATH=./nightshift.db

# Server
HOST=127.0.0.1
PORT=8000
